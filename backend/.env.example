# Tripo3D API Key (Get from https://platform.tripo3d.ai/)
TRIPO_API_KEY=your_tripo_api_key_here

# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/decoraai

# The URL of your frontend (for CORS)
FRONTEND_URL=https://your-app.netlify.app

# Optional: Server Port
PORT=5000
